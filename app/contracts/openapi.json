{
  "openapi": "3.1.1",
  "info": {
    "title": "RequestHub API",
    "description": "Request-and-approval API shared by every AI-SDLC demo phase. See app/contracts/README.md for errors, idempotency, concurrency, pagination, and authorization rules.",
