  "components": {
    "schemas": {
      "AttachmentDto": {
        "required": [
          "id",
          "fileName",
          "contentType",
          "sizeBytes",
          "sha256",
          "uploadedBy",
          "uploadedAt",
          "downloadUrl"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "fileName": {
            "type": "string"
          },
          "contentType": {
