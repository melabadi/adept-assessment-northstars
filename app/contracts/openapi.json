    "/api/meta": {
      "get": {
        "tags": [
          "Meta"
        ],
        "summary": "Build, environment, and contract metadata (no secrets).",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetaDto"
