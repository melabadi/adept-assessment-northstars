{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "functionBaseUrl": { "type": "String" },
    "identityId": { "type": "String" },
    "functionAudience": { "type": "String" }
  },
  "triggers": {
    "When_a_change_to_the_standards_merges": {
      "type": "Request",
      "kind": "Http",
      "inputs": {
        "method": "POST",
        "schema": {
          "type": "object",
          "properties": {
            "sha": { "type": "string" },
            "files": { "type": "array", "items": { "type": "string" } }
          },
          "required": [ "sha" ]
        }
      }
    }
  },
  "actions": {
    "Re-index_the_standards": {
      "type": "Http",
      "runAfter": {},
      "inputs": {
        "method": "POST",
        "uri": "@{parameters('functionBaseUrl')}/api/standards/sync",
        "body": { "sha": "@triggerBody()?['sha']" },
        "authentication": {
          "type": "ManagedServiceIdentity",
          "identity": "@parameters('identityId')",
          "audience": "@parameters('functionAudience')"
        }
      }
    },
    "Publish_the_advisor_agents": {
      "type": "Http",
      "runAfter": { "Re-index_the_standards": [ "Succeeded" ] },
      "inputs": {
        "method": "POST",
        "uri": "@{parameters('functionBaseUrl')}/api/agents/publish",
        "body": { "sha": "@triggerBody()?['sha']" },
        "authentication": {
          "type": "ManagedServiceIdentity",
          "identity": "@parameters('identityId')",
          "audience": "@parameters('functionAudience')"
        }
      }
    },
    "Evaluate_the_agents_in_Foundry": {
      "type": "Http",
      "runAfter": { "Publish_the_advisor_agents": [ "Succeeded" ] },
      "inputs": {
        "method": "POST",
        "uri": "@{parameters('functionBaseUrl')}/api/evaluations/start",
        "body": { "sha": "@triggerBody()?['sha']" },
        "authentication": {
          "type": "ManagedServiceIdentity",
          "identity": "@parameters('identityId')",
          "audience": "@parameters('functionAudience')"
        }
      }
    }
  },
  "outputs": {}
}
