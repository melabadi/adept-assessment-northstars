// Secure · Microsoft: RequestHub hosted in Azure, an Azure Policy assignment that audits its storage account, and the
// posture automation that turns the finding into a reviewed fix (a Logic App, a Function app, a Foundry agent, a what-if
// job), all in this solution's own resource group. Deploy from this folder with `azd up`; remove everything with
// `azd down --purge`.
targetScope = 'subscription'

@minLength(1)
@maxLength(24)
@description('azd environment name, for example ai-sdlc-secure. The resource group is rg-<name>.')
param environmentName string

@description('Region for the app, its database, and monitoring. PostgreSQL Flexible Server must be allowed there for your subscription.')
param location string

@description('Object id of the person running azd. Receives every RequestHub app role.')
param principalId string

@allowed(['User', 'ServicePrincipal'])
param principalType string = 'User'

@description('GitHub repository (owner/name) the posture automation files Issues and pull requests in. Set by the preprovision hook.')
param githubRepository string = ''

@secure()
@description('Fine-grained GitHub token for this repository only (Contents, Issues, Pull requests, Commit statuses). Created by a person; see the README.')
param postureGithubToken string = ''

@secure()
@description('The secret GitHub signs the repository webhook\'s deliveries with. Generated by the preprovision hook.')
param postureWebhookSecret string = ''

var tags = {
  'azd-env-name': environmentName
  solution: '05-secure-microsoft'
}

resource rg 'Microsoft.Resources/resourceGroups@2024-03-01' = {
  name: 'rg-${environmentName}'
  location: location
  tags: tags
}

// RequestHub and the Policy assignment live in resources.bicep, the file a posture fix changes. A pull request is
// previewed with a what-if of that file alone, by an identity that has no rights on the subscription.
module resources 'resources.bicep' = {
  name: 'resources'
  scope: rg
  params: {
    environmentName: environmentName
    location: location
    principalId: principalId
    principalType: principalType
  }
}

// The posture automation that runs in Azure: the Logic App posture-intake, the Function app, the Foundry agent, the
// what-if job, and the Defender automation.
module automation 'automation.bicep' = {
  name: 'automation'
  scope: rg
  params: {
    environmentName: environmentName
    location: location
    principalId: principalId
    principalType: principalType
    githubRepository: githubRepository
    githubToken: postureGithubToken
    webhookSecret: postureWebhookSecret
    automationIdentityName: resources.outputs.automationIdentityName
    containerAppsEnvironmentName: resources.outputs.containerAppsEnvironmentName
    storageAccountId: resources.outputs.storageAccountId
    policyAssignmentName: resources.outputs.policyAssignmentName
    appInsightsConnectionString: resources.outputs.appInsightsConnectionString
  }
}

output AZURE_LOCATION string = location
output AZURE_TENANT_ID string = tenant().tenantId
output AZURE_RESOURCE_GROUP string = rg.name
output POLICY_ASSIGNMENT_NAME string = resources.outputs.policyAssignmentName
output STORAGE_ACCOUNT_NAME string = resources.outputs.storageAccountName
output FOUNDRY_PROJECT_ENDPOINT string = automation.outputs.foundryProjectEndpoint
output FOUNDRY_MODEL_DEPLOYMENT string = automation.outputs.foundryModelDeployment
output REMEDIATION_AGENT_NAME string = automation.outputs.agentName
output INTAKE_WORKFLOW_NAME string = automation.outputs.intakeWorkflowName
output POSTURE_FUNCTION_NAME string = automation.outputs.functionAppName
output POSTURE_FUNCTION_HOST string = automation.outputs.functionHost
output WHATIF_JOB_NAME string = automation.outputs.whatifJobName

// Read by app/infra/api.parameters.json and worker.parameters.json when `azd deploy` ships the container apps.
output AZURE_CONTAINER_REGISTRY_ENDPOINT string = resources.outputs.registryLoginServer
output AZURE_CONTAINER_REGISTRY_NAME string = resources.outputs.registryName
output AZURE_CONTAINER_ENVIRONMENT_NAME string = resources.outputs.containerAppsEnvironmentName
output APP_IDENTITY_ID string = resources.outputs.appIdentityId
output APP_IDENTITY_CLIENT_ID string = resources.outputs.appIdentityClientId
output APP_IDENTITY_NAME string = resources.outputs.appIdentityName
output APPLICATIONINSIGHTS_CONNECTION_STRING string = resources.outputs.appInsightsConnectionString
output POSTGRES_HOST string = resources.outputs.postgresHost
output POSTGRES_DATABASE string = resources.outputs.postgresDatabase
output STORAGE_BLOB_ENDPOINT string = resources.outputs.storageBlobEndpoint
output API_APP_NAME string = resources.outputs.apiAppName
output WORKER_APP_NAME string = resources.outputs.workerAppName
output API_URL string = resources.outputs.apiUrl
output API_CLIENT_ID string = resources.outputs.apiClientId
output API_IDENTIFIER_URI string = resources.outputs.apiIdentifierUri
