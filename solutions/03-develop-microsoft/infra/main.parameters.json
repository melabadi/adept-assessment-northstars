{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "location": { "value": "${AZURE_LOCATION}" },
    "aiLocation": { "value": "${AZURE_AI_LOCATION=eastus2}" },
    "principalId": { "value": "${AZURE_PRINCIPAL_ID}" },
    "principalType": { "value": "${AZURE_PRINCIPAL_TYPE=User}" },
    "githubRepository": { "value": "${GITHUB_REPOSITORY}" },
    "githubToken": { "value": "${GITHUB_REVIEW_TOKEN=}" },
    "githubWebhookSecret": { "value": "${GITHUB_WEBHOOK_SECRET=}" },
    "checkerRef": { "value": "${REVIEW_CHECKER_REF=main}" },
    "reviewLabel": { "value": "${REVIEW_LABEL=review:azure}" }
  }
}
