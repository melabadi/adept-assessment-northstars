{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "repository": { "type": "String" },
    "githubToken": { "type": "SecureString", "defaultValue": "" },
    "checkerRef": { "type": "String", "defaultValue": "main" },
    "reviewLabel": { "type": "String", "defaultValue": "review:azure" },
    "judgePool": { "type": "String" },
    "runPool": { "type": "String" },
    "projectEndpoint": { "type": "String" },
    "agentName": { "type": "String" },
    "scriptsPath": { "type": "String", "defaultValue": "solutions/03-develop-microsoft/sandbox" }
  },
  "triggers": {
    "When_a_pull_request_event_arrives": {
      "type": "Request",
      "kind": "Http",
      "description": "GitHub's pull_request webhook, or {\"dryRun\": true, \"pr\": <number>} from eval_reviewer.py. Only the pull request number is used; everything else is read again from GitHub.",
      "inputs": { "method": "POST", "schema": {"type": "object"} },
      "conditions": [
        {
          "expression": "@or(equals(triggerBody()?['dryRun'], true), and(not(equals(triggerBody()?['pull_request'], null)), or(and(equals(triggerBody()?['action'], 'labeled'), equals(triggerBody()?['label']?['name'], parameters('reviewLabel'))), and(contains(createArray('synchronize', 'reopened', 'ready_for_review'), coalesce(triggerBody()?['action'], '')), contains(string(coalesce(triggerBody()?['pull_request']?['labels'], createArray())), parameters('reviewLabel'))))))"
        }
      ]
    }
  },
  "actions": {
    "Run_the_review": {
      "type": "Scope",
      "runAfter": {},
      "actions": {
        "PR_number": {
          "type": "Compose",
          "description": "The only value taken from the event. Everything else is read again from GitHub's API.",
          "inputs": "@int(if(equals(triggerBody()?['dryRun'], true), triggerBody()?['pr'], triggerBody()?['pull_request']?['number']))",
          "runAfter": {}
        },
        "Get_the_pull_request": {
          "type": "Http",
          "inputs": {
            "method": "GET",
            "uri": "https://api.github.com/repos/@{parameters('repository')}/pulls/@{outputs('PR_number')}",
            "headers": {
              "Accept": "application/vnd.github+json",
              "Authorization": "@{if(empty(parameters('githubToken')), '', concat('Bearer ', parameters('githubToken')))}",
              "User-Agent": "azure-pr-reviewer",
              "X-GitHub-Api-Version": "2022-11-28"
            }
          },
          "runtimeConfiguration": { "secureData": {"properties": ["inputs"]} },
          "runAfter": { "PR_number": ["Succeeded"] }
        },
        "Label_names": {
          "type": "Select",
          "inputs": {
            "from": "@coalesce(body('Get_the_pull_request')?['labels'], createArray())",
            "select": "@item()?['name']"
          },
          "runAfter": { "Get_the_pull_request": ["Succeeded"] }
        },
        "Is_it_ready_for_review": {
          "type": "If",
          "description": "Only pull requests whose branch is in this repository: a fork's code would otherwise run in the sandbox, and feed the agent, on every push. A real review also needs the pull request open, not a draft, aimed at the default branch, and labelled. A dry run (evaluation) needs only the first check and never posts.",
          "expression": "@and(equals(toLower(coalesce(body('Get_the_pull_request')?['head']?['repo']?['full_name'], '')), toLower(parameters('repository'))), or(equals(triggerBody()?['dryRun'], true), and(equals(body('Get_the_pull_request')?['state'], 'open'), equals(body('Get_the_pull_request')?['draft'], false), equals(body('Get_the_pull_request')?['base']?['ref'], body('Get_the_pull_request')?['base']?['repo']?['default_branch']), contains(body('Label_names'), parameters('reviewLabel')))))",
          "actions": {},
          "else": {
            "actions": { "Not_for_review": {"type": "Terminate", "inputs": {"runStatus": "Cancelled"}, "runAfter": {}} }
          },
          "runAfter": { "Label_names": ["Succeeded"] }
        },
        "Get_the_merge_base": {
          "type": "Http",
          "inputs": {
            "method": "GET",
            "uri": "https://api.github.com/repos/@{parameters('repository')}/compare/@{body('Get_the_pull_request')?['base']?['sha']}...@{body('Get_the_pull_request')?['head']?['sha']}?per_page=1",
            "headers": {
              "Accept": "application/vnd.github+json",
              "Authorization": "@{if(empty(parameters('githubToken')), '', concat('Bearer ', parameters('githubToken')))}",
              "User-Agent": "azure-pr-reviewer",
              "X-GitHub-Api-Version": "2022-11-28"
            }
          },
          "runtimeConfiguration": { "secureData": {"properties": ["inputs"]} },
          "runAfter": { "Is_it_ready_for_review": ["Succeeded"] }
        },
        "Merge_base": {
          "type": "Compose",
          "inputs": "@body('Get_the_merge_base')?['merge_base_commit']?['sha']",
          "runAfter": { "Get_the_merge_base": ["Succeeded"] }
        },
        "Download_the_code": {
          "type": "Scope",
          "description": "GitHub answers an archive request with a redirect (302 Found) to a short-lived download link, and a Logic App doesn't follow redirects. So each archive takes two calls: the first reports Found, the second downloads from its Location. Inputs and outputs are secured: the link carries a token, and the archives hold the repository's code.",
          "actions": {
            "Base_archive_link": {
              "type": "Http",
              "inputs": {
                "method": "GET",
                "uri": "https://api.github.com/repos/@{parameters('repository')}/tarball/@{outputs('Merge_base')}",
                "headers": {
                  "Authorization": "@{if(empty(parameters('githubToken')), '', concat('Bearer ', parameters('githubToken')))}",
                  "User-Agent": "azure-pr-reviewer",
                  "X-GitHub-Api-Version": "2022-11-28"
                }
              },
              "runtimeConfiguration": { "secureData": {"properties": ["inputs", "outputs"]} },
              "runAfter": {}
            },
            "Head_archive_link": {
              "type": "Http",
              "inputs": {
                "method": "GET",
                "uri": "https://api.github.com/repos/@{parameters('repository')}/tarball/@{body('Get_the_pull_request')?['head']?['sha']}",
                "headers": {
                  "Authorization": "@{if(empty(parameters('githubToken')), '', concat('Bearer ', parameters('githubToken')))}",
                  "User-Agent": "azure-pr-reviewer",
                  "X-GitHub-Api-Version": "2022-11-28"
                }
              },
              "runtimeConfiguration": { "secureData": {"properties": ["inputs", "outputs"]} },
              "runAfter": {}
            },
            "Get_the_base_archive": {
              "type": "Http",
              "inputs": { "method": "GET", "uri": "@{outputs('Base_archive_link')?['headers']?['Location']}" },
              "runtimeConfiguration": { "secureData": {"properties": ["inputs", "outputs"]} },
              "runAfter": { "Base_archive_link": ["Failed"] }
            },
            "Get_the_head_archive": {
              "type": "Http",
              "inputs": { "method": "GET", "uri": "@{outputs('Head_archive_link')?['headers']?['Location']}" },
              "runtimeConfiguration": { "secureData": {"properties": ["inputs", "outputs"]} },
              "runAfter": { "Head_archive_link": ["Failed"] }
            }
          },
          "runAfter": { "Merge_base": ["Succeeded"] }
        },
        "Get_the_rule_checker": {
          "type": "Http",
          "description": "From checkerRef (main), never from the pull request.",
          "inputs": {
            "method": "GET",
            "uri": "https://api.github.com/repos/@{parameters('repository')}/contents/@{parameters('scriptsPath')}/review_rules.py?ref=@{encodeUriComponent(parameters('checkerRef'))}",
            "headers": {
              "Accept": "application/vnd.github.raw",
              "Authorization": "@{if(empty(parameters('githubToken')), '', concat('Bearer ', parameters('githubToken')))}",
              "User-Agent": "azure-pr-reviewer",
              "X-GitHub-Api-Version": "2022-11-28"
            }
          },
          "runtimeConfiguration": { "secureData": {"properties": ["inputs"]} },
          "runAfter": { "Merge_base": ["Succeeded"] }
        },
        "Get_the_review_formatter": {
          "type": "Http",
          "description": "From checkerRef (main), never from the pull request.",
          "inputs": {
            "method": "GET",
            "uri": "https://api.github.com/repos/@{parameters('repository')}/contents/@{parameters('scriptsPath')}/format_review.py?ref=@{encodeUriComponent(parameters('checkerRef'))}",
            "headers": {
              "Accept": "application/vnd.github.raw",
              "Authorization": "@{if(empty(parameters('githubToken')), '', concat('Bearer ', parameters('githubToken')))}",
              "User-Agent": "azure-pr-reviewer",
              "X-GitHub-Api-Version": "2022-11-28"
            }
          },
          "runtimeConfiguration": { "secureData": {"properties": ["inputs"]} },
          "runAfter": { "Merge_base": ["Succeeded"] }
        },
        "Get_the_sandbox_runner": {
          "type": "Http",
          "description": "From checkerRef (main), never from the pull request.",
          "inputs": {
            "method": "GET",
            "uri": "https://api.github.com/repos/@{parameters('repository')}/contents/@{parameters('scriptsPath')}/run_change.sh?ref=@{encodeUriComponent(parameters('checkerRef'))}",
            "headers": {
              "Accept": "application/vnd.github.raw",
              "Authorization": "@{if(empty(parameters('githubToken')), '', concat('Bearer ', parameters('githubToken')))}",
              "User-Agent": "azure-pr-reviewer",
              "X-GitHub-Api-Version": "2022-11-28"
            }
          },
          "runtimeConfiguration": { "secureData": {"properties": ["inputs"]} },
          "runAfter": { "Merge_base": ["Succeeded"] }
        },
        "Judge_upload_the_checker": {
          "type": "Http",
          "inputs": {
            "method": "POST",
            "uri": "@{parameters('judgePool')}/files?api-version=2025-10-02-preview&identifier=judge-@{workflow()?['run']?['name']}",
            "body": {
              "$content-type": "multipart/form-data",
              "$multipart": [
                {
                  "headers": { "Content-Disposition": "form-data; name=\"file\"; filename=\"review_rules.py\"" },
                  "body": "@body('Get_the_rule_checker')"
                }
              ]
            },
            "authentication": { "type": "ManagedServiceIdentity", "audience": "https://dynamicsessions.io" }
          },
          "runAfter": { "Get_the_rule_checker": ["Succeeded"] }
        },
        "Judge_upload_the_formatter": {
          "type": "Http",
          "inputs": {
            "method": "POST",
            "uri": "@{parameters('judgePool')}/files?api-version=2025-10-02-preview&identifier=judge-@{workflow()?['run']?['name']}",
            "body": {
              "$content-type": "multipart/form-data",
              "$multipart": [
                {
                  "headers": { "Content-Disposition": "form-data; name=\"file\"; filename=\"format_review.py\"" },
                  "body": "@body('Get_the_review_formatter')"
                }
              ]
            },
            "authentication": { "type": "ManagedServiceIdentity", "audience": "https://dynamicsessions.io" }
          },
          "runAfter": { "Get_the_review_formatter": ["Succeeded"], "Judge_upload_the_checker": ["Succeeded"] }
        },
        "Judge_upload_the_base": {
          "type": "Http",
          "inputs": {
            "method": "POST",
            "uri": "@{parameters('judgePool')}/files?api-version=2025-10-02-preview&identifier=judge-@{workflow()?['run']?['name']}",
            "body": {
              "$content-type": "multipart/form-data",
              "$multipart": [
                {
                  "headers": { "Content-Disposition": "form-data; name=\"file\"; filename=\"base.tgz\"" },
                  "body": "@body('Get_the_base_archive')"
                }
              ]
            },
            "authentication": { "type": "ManagedServiceIdentity", "audience": "https://dynamicsessions.io" }
          },
          "runAfter": { "Download_the_code": ["Succeeded"], "Judge_upload_the_formatter": ["Succeeded"] }
        },
        "Judge_upload_the_head": {
          "type": "Http",
          "inputs": {
            "method": "POST",
            "uri": "@{parameters('judgePool')}/files?api-version=2025-10-02-preview&identifier=judge-@{workflow()?['run']?['name']}",
            "body": {
              "$content-type": "multipart/form-data",
              "$multipart": [
                {
                  "headers": { "Content-Disposition": "form-data; name=\"file\"; filename=\"head.tgz\"" },
                  "body": "@body('Get_the_head_archive')"
                }
              ]
            },
            "authentication": { "type": "ManagedServiceIdentity", "audience": "https://dynamicsessions.io" }
          },
          "runAfter": { "Judge_upload_the_base": ["Succeeded"] }
        },
        "Judge_check_the_team_rules": {
          "type": "Http",
          "description": "The rule checker from main reads both trees as data and writes judge.json. No code from the pull request has run anywhere yet.",
          "inputs": {
            "method": "POST",
            "uri": "@{parameters('judgePool')}/executions?api-version=2025-10-02-preview&identifier=judge-@{workflow()?['run']?['name']}",
            "headers": { "Content-Type": "application/json" },
            "body": {
              "shellCommand": "cd /mnt/data && python3 review_rules.py --base base.tgz --head head.tgz > judge.json; status=$?; echo \"review_rules.py exit code $status; judge.json is $(wc -c < judge.json) bytes\"; exit $status",
              "timeoutInSeconds": 120
            },
            "authentication": { "type": "ManagedServiceIdentity", "audience": "https://dynamicsessions.io" }
          },
          "runAfter": { "Judge_upload_the_head": ["Succeeded"] }
        },
        "Judge_read_the_verdicts": {
          "type": "Http",
          "description": "Downloads judge.json from the judge's session. A session cuts a command's output after 4 KB, so every result travels as a file.",
          "inputs": {
            "method": "GET",
            "uri": "@{parameters('judgePool')}/files/judge.json/content?api-version=2025-10-02-preview&identifier=judge-@{workflow()?['run']?['name']}",
            "authentication": { "type": "ManagedServiceIdentity", "audience": "https://dynamicsessions.io" }
          },
          "runAfter": { "Judge_check_the_team_rules": ["Succeeded"] }
        },
        "Judge_output": {
          "type": "Compose",
          "description": "What the rule checker wrote: its verdicts, and the change as a unified diff for the agent.",
          "inputs": "@json(base64ToString(body('Judge_read_the_verdicts')?['$content']))",
          "runAfter": { "Judge_read_the_verdicts": ["Succeeded"] }
        },
        "Rules": {
          "type": "Compose",
          "description": "The checker's verdicts. This step fails, and the review stops before any pull request code runs, unless the checker produced them.",
          "inputs": "@outputs('Judge_output')['rules']",
          "runAfter": { "Judge_output": ["Succeeded"] }
        },
        "Build_and_test": {
          "type": "Scope",
          "description": "Only now does any of the pull request's code run, in its own session. If the build can't run, the review still posts the rule results.",
          "actions": {
            "Run_upload_the_runner": {
              "type": "Http",
              "inputs": {
                "method": "POST",
                "uri": "@{parameters('runPool')}/files?api-version=2025-10-02-preview&identifier=run-@{workflow()?['run']?['name']}",
                "body": {
                  "$content-type": "multipart/form-data",
                  "$multipart": [
                    {
                      "headers": { "Content-Disposition": "form-data; name=\"file\"; filename=\"run_change.sh\"" },
                      "body": "@body('Get_the_sandbox_runner')"
                    }
                  ]
                },
                "authentication": { "type": "ManagedServiceIdentity", "audience": "https://dynamicsessions.io" }
              },
              "runAfter": {}
            },
            "Run_upload_the_head": {
              "type": "Http",
              "inputs": {
                "method": "POST",
                "uri": "@{parameters('runPool')}/files?api-version=2025-10-02-preview&identifier=run-@{workflow()?['run']?['name']}",
                "body": {
                  "$content-type": "multipart/form-data",
                  "$multipart": [
                    {
                      "headers": { "Content-Disposition": "form-data; name=\"file\"; filename=\"head.tgz\"" },
                      "body": "@body('Get_the_head_archive')"
                    }
                  ]
                },
                "authentication": { "type": "ManagedServiceIdentity", "audience": "https://dynamicsessions.io" }
              },
              "runAfter": { "Run_upload_the_runner": ["Succeeded"] }
            },
            "Run_start_the_build": {
              "type": "Http",
              "description": "From here on, the pull request's own code runs, in its own session.",
              "inputs": {
                "method": "POST",
                "uri": "@{parameters('runPool')}/executions?api-version=2025-10-02-preview&identifier=run-@{workflow()?['run']?['name']}",
                "headers": { "Content-Type": "application/json" },
                "body": { "shellCommand": "bash /mnt/data/run_change.sh start", "timeoutInSeconds": 30 },
                "authentication": { "type": "ManagedServiceIdentity", "audience": "https://dynamicsessions.io" }
              },
              "runAfter": { "Run_upload_the_head": ["Succeeded"] }
            },
            "Run_wait_for_the_build": {
              "type": "Until",
              "expression": "@contains(string(coalesce(body('Run_build_status')?['result']?['stdout'], '')), '\"state\":\"done\"')",
              "limit": { "count": 60, "timeout": "PT20M" },
              "actions": {
                "Pause": { "type": "Wait", "inputs": {"interval": {"count": 20, "unit": "Second"}}, "runAfter": {} },
                "Run_build_status": {
                  "type": "Http",
                  "inputs": {
                    "method": "POST",
                    "uri": "@{parameters('runPool')}/executions?api-version=2025-10-02-preview&identifier=run-@{workflow()?['run']?['name']}",
                    "headers": { "Content-Type": "application/json" },
                    "body": { "shellCommand": "bash /mnt/data/run_change.sh status", "timeoutInSeconds": 30 },
                    "authentication": { "type": "ManagedServiceIdentity", "audience": "https://dynamicsessions.io" }
                  },
                  "runAfter": { "Pause": ["Succeeded"] }
                }
              },
              "runAfter": { "Run_start_the_build": ["Succeeded"] }
            },
            "Run_get_the_results": {
              "type": "Http",
              "description": "Downloads run/summary.json. run_change.sh writes a not-finished placeholder when it starts, so a build that runs out of time has one too.",
              "inputs": {
                "method": "GET",
                "uri": "@{parameters('runPool')}/files/summary.json/content?api-version=2025-10-02-preview&identifier=run-@{workflow()?['run']?['name']}&path=run",
                "authentication": { "type": "ManagedServiceIdentity", "audience": "https://dynamicsessions.io" }
              },
              "runAfter": { "Run_wait_for_the_build": ["Succeeded", "Failed", "TimedOut"] }
            },
            "Run_results": {
              "type": "Compose",
              "description": "The summary as text, at most 20,000 characters: the pull request's code could have written anything in that file.",
              "inputs": "@take(base64ToString(body('Run_get_the_results')?['$content']), 20000)",
              "runAfter": { "Run_get_the_results": ["Succeeded"] }
            }
          },
          "runAfter": { "Rules": ["Succeeded"], "Get_the_sandbox_runner": ["Succeeded"] }
        },
        "Sandbox_results": {
          "type": "Compose",
          "description": "Reported by the pull request's own code: evidence, not a verdict. Empty when the build couldn't run.",
          "inputs": "@string(coalesce(actions('Run_results')?['outputs'], ''))",
          "runAfter": { "Build_and_test": ["Succeeded", "Failed", "TimedOut"] }
        },
        "Agent_input": {
          "type": "Compose",
          "inputs": {
            "pr": {
              "number": "@outputs('PR_number')",
              "title": "@body('Get_the_pull_request')?['title']",
              "author": "@body('Get_the_pull_request')?['user']?['login']",
              "description": "@take(coalesce(body('Get_the_pull_request')?['body'], ''), 4000)",
              "base": "@outputs('Merge_base')",
              "head": "@body('Get_the_pull_request')?['head']?['sha']"
            },
            "rules": "@outputs('Rules')",
            "sandbox": "@outputs('Sandbox_results')",
            "run_session": "run-@{workflow()?['run']?['name']}",
            "diff_truncated": "@outputs('Judge_output')?['diff_truncated']",
            "diff": "@outputs('Judge_output')?['diff']"
          },
          "runAfter": { "Sandbox_results": ["Succeeded"] }
        },
        "Ask_the_agent": {
          "type": "Scope",
          "description": "Starts the agent in background mode and polls for its answer; asks once more if the answer doesn't complete.",
          "actions": {
            "Ask_the_reviewer_agent": {
              "type": "Http",
              "inputs": {
                "method": "POST",
                "uri": "@{parameters('projectEndpoint')}/openai/v1/responses",
                "headers": { "Content-Type": "application/json" },
                "body": {
                  "agent_reference": { "type": "agent_reference", "name": "@{parameters('agentName')}" },
                  "input": "@{string(outputs('Agent_input'))}",
                  "background": true
                },
                "authentication": { "type": "ManagedServiceIdentity", "audience": "https://ai.azure.com" }
              },
              "runAfter": {},
              "description": "Starts the agent in background mode, so a long review can't hit the HTTP timeout; the next step polls for the answer."
            },
            "Wait_for_the_agent": {
              "type": "Until",
              "expression": "@not(contains(createArray('queued', 'in_progress'), coalesce(body('Agent_status')?['status'], 'queued')))",
              "limit": { "count": 120, "timeout": "PT10M" },
              "actions": {
                "Agent_pause": { "type": "Wait", "inputs": {"interval": {"count": 5, "unit": "Second"}}, "runAfter": {} },
                "Agent_status": {
                  "type": "Http",
                  "inputs": {
                    "method": "GET",
                    "uri": "@{parameters('projectEndpoint')}/openai/v1/responses/@{body('Ask_the_reviewer_agent')?['id']}",
                    "authentication": { "type": "ManagedServiceIdentity", "audience": "https://ai.azure.com" }
                  },
                  "runAfter": { "Agent_pause": ["Succeeded"] }
                }
              },
              "runAfter": { "Ask_the_reviewer_agent": ["Succeeded"] }
            },
            "If_the_agent_failed_try_again": {
              "type": "If",
              "description": "A model call can fail now and then, for example when a safety filter flags text from the pull request. One retry keeps the commentary; the rule results never depend on it.",
              "expression": "@not(equals(actions('Agent_status')?['outputs']?['body']?['status'], 'completed'))",
              "actions": {
                "Ask_the_agent_again": {
                  "type": "Http",
                  "inputs": {
                    "method": "POST",
                    "uri": "@{parameters('projectEndpoint')}/openai/v1/responses",
                    "headers": { "Content-Type": "application/json" },
                    "body": {
                      "agent_reference": { "type": "agent_reference", "name": "@{parameters('agentName')}" },
                      "input": "@{string(outputs('Agent_input'))}",
                      "background": true
                    },
                    "authentication": { "type": "ManagedServiceIdentity", "audience": "https://ai.azure.com" }
                  },
                  "runAfter": {},
                  "description": "Starts the agent again, once."
                },
                "Wait_for_the_agent_again": {
                  "type": "Until",
                  "expression": "@not(contains(createArray('queued', 'in_progress'), coalesce(body('Agent_status_again')?['status'], 'queued')))",
                  "limit": { "count": 120, "timeout": "PT10M" },
                  "actions": {
                    "Agent_pause_again": { "type": "Wait", "inputs": {"interval": {"count": 5, "unit": "Second"}}, "runAfter": {} },
                    "Agent_status_again": {
                      "type": "Http",
                      "inputs": {
                        "method": "GET",
                        "uri": "@{parameters('projectEndpoint')}/openai/v1/responses/@{body('Ask_the_agent_again')?['id']}",
                        "authentication": { "type": "ManagedServiceIdentity", "audience": "https://ai.azure.com" }
                      },
                      "runAfter": { "Agent_pause_again": ["Succeeded"] }
                    }
                  },
                  "runAfter": { "Ask_the_agent_again": ["Succeeded"] }
                }
              },
              "else": { "actions": {} },
              "runAfter": { "Wait_for_the_agent": ["Succeeded", "Failed", "TimedOut", "Skipped"] }
            }
          },
          "runAfter": { "Agent_input": ["Succeeded"] }
        },
        "Agent_result": {
          "type": "Compose",
          "description": "The agent's answer, or the error that stopped it. The review goes on either way.",
          "inputs": "@coalesce(actions('Agent_status_again')?['outputs']?['body'], actions('Ask_the_agent_again')?['outputs']?['body'], actions('Agent_status')?['outputs']?['body'], actions('Ask_the_reviewer_agent')?['outputs']?['body'], json('{}'))",
          "runAfter": { "Ask_the_agent": ["Succeeded", "Failed", "TimedOut"] }
        },
        "Review_input": {
          "type": "Compose",
          "inputs": {
            "pr": {
              "number": "@outputs('PR_number')",
              "title": "@body('Get_the_pull_request')?['title']",
              "head": "@body('Get_the_pull_request')?['head']?['sha']",
              "base": "@outputs('Merge_base')"
            },
            "run": "@{workflow()?['run']?['name']}",
            "dry_run": "@equals(triggerBody()?['dryRun'], true)",
            "checker_ref": "@parameters('checkerRef')",
            "agent_name": "@parameters('agentName')",
            "sandbox": "@outputs('Sandbox_results')",
            "agent_status": "@{coalesce(actions('Agent_status_again')?['outputs']?['body']?['status'], actions('Agent_status')?['outputs']?['body']?['status'], actions('Ask_the_reviewer_agent')?['status'])}"
          },
          "runAfter": { "Agent_result": ["Succeeded"] }
        },
        "Judge_upload_the_review_input": {
          "type": "Http",
          "inputs": {
            "method": "POST",
            "uri": "@{parameters('judgePool')}/files?api-version=2025-10-02-preview&identifier=judge-@{workflow()?['run']?['name']}",
            "body": {
              "$content-type": "multipart/form-data",
              "$multipart": [
                {
                  "headers": {
                    "Content-Disposition": "form-data; name=\"file\"; filename=\"review-input.json\"",
                    "Content-Type": "application/json"
                  },
                  "body": "@{string(outputs('Review_input'))}"
                }
              ]
            },
            "authentication": { "type": "ManagedServiceIdentity", "audience": "https://dynamicsessions.io" }
          },
          "runAfter": { "Review_input": ["Succeeded"] }
        },
        "Judge_upload_the_agent_answer": {
          "type": "Http",
          "inputs": {
            "method": "POST",
            "uri": "@{parameters('judgePool')}/files?api-version=2025-10-02-preview&identifier=judge-@{workflow()?['run']?['name']}",
            "body": {
              "$content-type": "multipart/form-data",
              "$multipart": [
                {
                  "headers": {
                    "Content-Disposition": "form-data; name=\"file\"; filename=\"agent.json\"",
                    "Content-Type": "application/json"
                  },
                  "body": "@outputs('Agent_result')"
                }
              ]
            },
            "authentication": { "type": "ManagedServiceIdentity", "audience": "https://dynamicsessions.io" }
          },
          "runAfter": { "Judge_upload_the_review_input": ["Succeeded"] }
        },
        "Judge_write_the_review": {
          "type": "Http",
          "description": "Back in the judge's session: the rule verdicts come from the checker's own judge.json, word for word.",
          "inputs": {
            "method": "POST",
            "uri": "@{parameters('judgePool')}/executions?api-version=2025-10-02-preview&identifier=judge-@{workflow()?['run']?['name']}",
            "headers": { "Content-Type": "application/json" },
            "body": {
              "shellCommand": "cd /mnt/data && python3 format_review.py --judge judge.json --input review-input.json --agent agent.json > review.json; status=$?; echo \"format_review.py exit code $status; review.json is $(wc -c < review.json) bytes\"; exit $status",
              "timeoutInSeconds": 60
            },
            "authentication": { "type": "ManagedServiceIdentity", "audience": "https://dynamicsessions.io" }
          },
          "runAfter": { "Judge_upload_the_agent_answer": ["Succeeded"] }
        },
        "Judge_read_the_review": {
          "type": "Http",
          "description": "Downloads review.json from the judge's session.",
          "inputs": {
            "method": "GET",
            "uri": "@{parameters('judgePool')}/files/review.json/content?api-version=2025-10-02-preview&identifier=judge-@{workflow()?['run']?['name']}",
            "authentication": { "type": "ManagedServiceIdentity", "audience": "https://dynamicsessions.io" }
          },
          "runAfter": { "Judge_write_the_review": ["Succeeded"] }
        },
        "Review": {
          "type": "Compose",
          "inputs": "@json(base64ToString(body('Judge_read_the_review')?['$content']))",
          "runAfter": { "Judge_read_the_review": ["Succeeded"] }
        },
        "Unless_this_is_a_dry_run": {
          "type": "If",
          "expression": "@not(equals(triggerBody()?['dryRun'], true))",
          "actions": {
            "Read_the_pull_request_again": {
              "type": "Http",
              "inputs": {
                "method": "GET",
                "uri": "https://api.github.com/repos/@{parameters('repository')}/pulls/@{outputs('PR_number')}",
                "headers": {
                  "Accept": "application/vnd.github+json",
                  "Authorization": "@{if(empty(parameters('githubToken')), '', concat('Bearer ', parameters('githubToken')))}",
                  "User-Agent": "azure-pr-reviewer",
                  "X-GitHub-Api-Version": "2022-11-28"
                }
              },
              "runtimeConfiguration": { "secureData": {"properties": ["inputs"]} },
              "runAfter": {},
              "description": "Reads the pull request again: if someone pushed while this review ran, a newer review is on its way."
            },
            "If_the_head_is_unchanged": {
              "type": "If",
              "description": "Posts only for the commit that is still the pull request's head, so an older review never lands after a newer one.",
              "expression": "@equals(body('Read_the_pull_request_again')?['head']?['sha'], body('Get_the_pull_request')?['head']?['sha'])",
              "actions": {
                "Post_the_review": {
                  "type": "Http",
                  "description": "A COMMENT review: it never approves and never requests changes.",
                  "inputs": {
                    "method": "POST",
                    "uri": "https://api.github.com/repos/@{parameters('repository')}/pulls/@{outputs('PR_number')}/reviews",
                    "headers": {
                      "Accept": "application/vnd.github+json",
                      "Authorization": "@{if(empty(parameters('githubToken')), '', concat('Bearer ', parameters('githubToken')))}",
                      "User-Agent": "azure-pr-reviewer",
                      "X-GitHub-Api-Version": "2022-11-28"
                    },
                    "body": {
                      "commit_id": "@{body('Get_the_pull_request')?['head']?['sha']}",
                      "event": "COMMENT",
                      "body": "@{outputs('Review')['markdown']}"
                    },
                    "retryPolicy": { "type": "none" }
                  },
                  "runtimeConfiguration": { "secureData": {"properties": ["inputs"]} },
                  "runAfter": {}
                }
              },
              "else": {
                "actions": {
                  "Superseded": {
                    "type": "Compose",
                    "inputs": "A newer commit was pushed while this review ran; its own review posts instead.",
                    "runAfter": {}
                  }
                }
              },
              "runAfter": { "Read_the_pull_request_again": ["Succeeded"] }
            }
          },
          "else": { "actions": {} },
          "runAfter": { "Review": ["Succeeded"] }
        },
        "Result": {
          "type": "Compose",
          "description": "What eval_reviewer.py reads back after a dry run.",
          "inputs": {
            "pr": "@outputs('PR_number')",
            "head": "@body('Get_the_pull_request')?['head']?['sha']",
            "base": "@outputs('Merge_base')",
            "dry_run": "@equals(triggerBody()?['dryRun'], true)",
            "rules": "@outputs('Rules')",
            "sandbox": "@outputs('Sandbox_results')",
            "agent": "@outputs('Review')?['agent']",
            "agent_error": "@outputs('Review')?['agent_error']",
            "review": "@outputs('Review')?['markdown']",
            "review_url": "@actions('Post_the_review')?['outputs']?['body']?['html_url']"
          },
          "runAfter": { "Unless_this_is_a_dry_run": ["Succeeded"] }
        }
      }
    },
    "Delete_the_judge_session": {
      "type": "Http",
      "inputs": {
        "method": "DELETE",
        "uri": "@{parameters('judgePool')}/session?api-version=2025-02-02-preview&identifier=judge-@{workflow()?['run']?['name']}",
        "authentication": { "type": "ManagedServiceIdentity", "audience": "https://dynamicsessions.io" },
        "retryPolicy": { "type": "none" }
      },
      "runAfter": { "Run_the_review": ["Succeeded", "Failed", "Skipped", "TimedOut"] }
    },
    "Delete_the_run_session": {
      "type": "Http",
      "inputs": {
        "method": "DELETE",
        "uri": "@{parameters('runPool')}/session?api-version=2025-02-02-preview&identifier=run-@{workflow()?['run']?['name']}",
        "authentication": { "type": "ManagedServiceIdentity", "audience": "https://dynamicsessions.io" },
        "retryPolicy": { "type": "none" }
      },
      "runAfter": { "Run_the_review": ["Succeeded", "Failed", "Skipped", "TimedOut"] }
    },
    "If_the_review_failed": {
      "type": "If",
      "description": "Posts a short note only for a real pull request that was eligible for review.",
      "expression": "@and(not(equals(triggerBody()?['dryRun'], true)), equals(actions('Is_it_ready_for_review')?['status'], 'Succeeded'))",
      "actions": {
        "Post_a_failure_note": {
          "type": "Http",
          "inputs": {
            "method": "POST",
            "uri": "https://api.github.com/repos/@{parameters('repository')}/pulls/@{outputs('PR_number')}/reviews",
            "headers": {
              "Accept": "application/vnd.github+json",
              "Authorization": "@{if(empty(parameters('githubToken')), '', concat('Bearer ', parameters('githubToken')))}",
              "User-Agent": "azure-pr-reviewer",
              "X-GitHub-Api-Version": "2022-11-28"
            },
            "body": {
              "event": "COMMENT",
              "body": "### Azure pull request review · advisory\n\nThe reviewer couldn't finish this review (Logic App run `@{workflow()?['run']?['name']}`). Nothing was decided; review this pull request as usual. To try again, remove and add the `@{parameters('reviewLabel')}` label.\n\n<!-- azure-pr-reviewer run=@{workflow()?['run']?['name']} failed -->"
            },
            "retryPolicy": { "type": "none" }
          },
          "runtimeConfiguration": { "secureData": {"properties": ["inputs"]} },
          "runAfter": {}
        }
      },
      "else": { "actions": {} },
      "runAfter": { "Run_the_review": ["Failed", "TimedOut"] }
    },
    "Mark_the_run_failed": {
      "type": "Terminate",
      "inputs": {
        "runStatus": "Failed",
        "runError": {
          "code": "ReviewFailed",
          "message": "The review didn't finish. See the failed step in Run_the_review."
        }
      },
      "runAfter": {
        "If_the_review_failed": ["Succeeded", "Failed"],
        "Delete_the_judge_session": ["Succeeded", "Failed"],
        "Delete_the_run_session": ["Succeeded", "Failed"]
      }
    }
  },
  "outputs": {}
}
