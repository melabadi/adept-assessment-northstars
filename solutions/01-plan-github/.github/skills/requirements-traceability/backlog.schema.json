{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Requirements brief and engineering backlog",
  "description": "Output of the Plan phase. Every statement cites its source: transcript paragraphs (T01-T99) or policy ids (POL-...).",
  "type": "object",
  "additionalProperties": false,
  "required": ["scenario", "brief", "epic", "tasks", "openQuestions", "conflicts", "decisions"],
  "properties": {
    "scenario": { "type": "string", "enum": ["assisted-triage-brief"] },
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["problem", "goals", "requirements", "outOfScope", "successMeasures"],
      "properties": {
        "problem": { "$ref": "#/$defs/sourced" },
        "goals": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourced" } },
        "requirements": { "type": "array", "minItems": 4, "items": { "$ref": "#/$defs/requirement" } },
        "outOfScope": { "type": "array", "items": { "$ref": "#/$defs/sourced" } },
        "successMeasures": { "type": "array", "items": { "$ref": "#/$defs/sourced" } }
      }
    },
    "epic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "summary", "acceptanceCriteria", "sources"],
      "properties": {
        "id": { "type": "string", "pattern": "^EPIC-[A-Z0-9-]+$" },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "acceptanceCriteria": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "sources": { "$ref": "#/$defs/sources" }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "description", "ownerRole", "acceptanceCriteria", "sources", "dependsOn"],
        "properties": {
          "id": { "type": "string", "pattern": "^TASK-[0-9]+$" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "ownerRole": { "type": "string", "enum": ["Backend engineer", "Frontend engineer", "Full-stack engineer", "QA engineer", "Platform engineer", "Security engineer"] },
          "acceptanceCriteria": { "type": "array", "minItems": 2, "items": { "type": "string" } },
          "sources": { "$ref": "#/$defs/sources" },
          "dependsOn": { "type": "array", "items": { "type": "string", "pattern": "^TASK-[0-9]+$" } }
        }
      }
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "sources", "blocking"],
        "properties": {
          "id": { "type": "string", "pattern": "^Q[0-9]+$" },
          "question": { "type": "string" },
          "sources": { "$ref": "#/$defs/sources" },
          "blocking": { "type": "boolean" }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "summary", "sources", "resolution", "resolvedBy"],
        "properties": {
          "id": { "type": "string", "pattern": "^C[0-9]+$" },
          "summary": { "type": "string" },
          "sources": { "$ref": "#/$defs/sources" },
          "resolution": { "type": ["string", "null"] },
          "resolvedBy": { "type": ["string", "null"], "description": "Source id of the decision that resolved the conflict, or null when unresolved." }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "decision", "sources"],
        "properties": {
          "id": { "type": "string", "pattern": "^D[0-9]+$" },
          "decision": { "type": "string" },
          "sources": { "$ref": "#/$defs/sources" }
        }
      }
    }
  },
  "$defs": {
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^(T[0-9]{2}|POL-[A-Z]+-[0-9]{3})$" }
    },
    "sourced": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "sources"],
      "properties": {
        "text": { "type": "string" },
        "sources": { "$ref": "#/$defs/sources" }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "priority", "sources"],
      "properties": {
        "id": { "type": "string", "pattern": "^R[0-9]+$" },
        "text": { "type": "string" },
        "priority": { "type": "string", "enum": ["must", "should", "could"] },
        "sources": { "$ref": "#/$defs/sources" }
      }
    }
  }
}
