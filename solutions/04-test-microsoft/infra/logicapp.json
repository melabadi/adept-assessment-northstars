{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "loadTestingEndpoint": {
      "type": "string",
      "metadata": {
        "description": "Data-plane endpoint of the Azure Load Testing resource (https://...)."
      }
    },
    "testId": {
      "type": "string",
      "metadata": {
        "description": "Test whose runs this workflow reports, for example requesthub-journey."
      }
    },
    "workspaceId": {
      "type": "string",
      "metadata": {
        "description": "Workspace id of the Log Analytics workspace that holds RequestHub's Application Insights data."
      }
    },
    "resourceGroupName": {
      "type": "string",
      "metadata": {
        "description": "Resource group named in the report, so readers can find the run in the Azure portal."
      }
    },
    "githubRepository": {
      "type": "string",
      "metadata": {
        "description": "Repository (owner/name) whose Issues track a failing journey."
      }
    },
    "githubToken": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "Fine-grained GitHub token for this repository only, with Issues read and write. Empty: the report is built but not posted."
      }
    },
    "reportQuery": {
      "type": "string",
      "metadata": {
        "description": "infra/report.kql: turns the run and the API's telemetry into the Markdown report."
      }
    }
  },
  "triggers": {
    "When_a_test_run_ends": {
      "type": "Request",
      "kind": "Http",
      "inputs": {
        "schema": {}
      },
      "description": "Called by the action group that the test's notification rule sends finished runs to (Azure Monitor common alert schema)."
    }
  },
  "actions": {
    "Test_run_id": {
      "type": "Compose",
      "description": "The notification uses the Azure Monitor common alert schema; its alert context names the run that ended.",
      "inputs": "@coalesce(triggerBody()?['data']?['data']?['alertContext']?['testRunId'], triggerBody()?['data']?['alertContext']?['testRunId'], '')",
      "runAfter": {}
    },
    "Initialize_run": {
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "run",
            "type": "object",
            "value": {}
          }
        ]
      },
      "runAfter": {
        "Test_run_id": [
          "Succeeded"
        ]
      }
    },
    "Wait_for_the_verdict": {
      "type": "Until",
      "description": "Reads the run from Azure Load Testing with this Logic App's managed identity (Load Test Reader). A run can reach DONE a minute or two before its statistics and pass/fail verdict are ready, so check once a minute.",
      "expression": "@or(contains(createArray('PASSED', 'FAILED'), variables('run')?['testResult']), equals(variables('run')?['status'], 'CANCELLED'))",
      "limit": {
        "count": 10,
        "timeout": "PT15M"
      },
      "actions": {
        "Get_the_run": {
          "type": "Http",
          "inputs": {
            "method": "GET",
            "uri": "@{parameters('loadTestingEndpoint')}/test-runs/@{outputs('Test_run_id')}",
            "queries": {
              "api-version": "2024-12-01-preview"
            },
            "authentication": {
              "type": "ManagedServiceIdentity",
              "audience": "https://cnt-prod.loadtesting.azure.com"
            }
          },
          "runAfter": {}
        },
        "Set_run": {
          "type": "SetVariable",
          "inputs": {
            "name": "run",
            "value": "@body('Get_the_run')"
          },
          "runAfter": {
            "Get_the_run": [
              "Succeeded"
            ]
          }
        },
        "Not_final_yet": {
          "type": "If",
          "expression": {
            "and": [
              {
                "equals": [
                  "@contains(createArray('PASSED', 'FAILED'), variables('run')?['testResult'])",
                  false
                ]
              },
              {
                "not": {
                  "equals": [
                    "@variables('run')?['status']",
                    "CANCELLED"
                  ]
                }
              }
            ]
          },
          "actions": {
            "Wait_a_minute": {
              "type": "Wait",
              "inputs": {
                "interval": {
                  "count": 1,
                  "unit": "Minute"
                }
              }
            }
          },
          "else": {
            "actions": {}
          },
          "runAfter": {
            "Set_run": [
              "Succeeded"
            ]
          }
        }
      },
      "runAfter": {
        "Initialize_run": [
          "Succeeded"
        ]
      }
    },
    "Run": {
      "type": "Compose",
      "description": "The run that ended.",
      "inputs": "@variables('run')",
      "runAfter": {
        "Wait_for_the_verdict": [
          "Succeeded"
        ]
      }
    },
    "Stop_when_the_run_has_no_verdict": {
      "type": "If",
      "description": "Cancelled runs, and runs without pass/fail criteria results, are not reported.",
      "expression": {
        "and": [
          {
            "not": {
              "contains": [
                "@createArray('PASSED', 'FAILED')",
                "@outputs('Run')?['testResult']"
              ]
            }
          }
        ]
      },
      "actions": {
        "No_verdict": {
          "type": "Terminate",
          "inputs": {
            "runStatus": "Cancelled"
          }
        }
      },
      "else": {
        "actions": {}
      },
      "runAfter": {
        "Run": [
          "Succeeded"
        ]
      }
    },
    "Run_summary": {
      "type": "Compose",
      "description": "Only what the report shows: no endpoints, ids, or environment values.",
      "inputs": {
        "testId": "@outputs('Run')?['testId']",
        "displayName": "@outputs('Run')?['displayName']",
        "status": "@outputs('Run')?['status']",
        "testResult": "@outputs('Run')?['testResult']",
        "startDateTime": "@outputs('Run')?['startDateTime']",
        "endDateTime": "@outputs('Run')?['endDateTime']",
        "virtualUsers": "@outputs('Run')?['virtualUsers']",
        "duration": "@outputs('Run')?['duration']",
        "passFailCriteria": "@outputs('Run')?['passFailCriteria']",
        "testRunStatistics": "@outputs('Run')?['testRunStatistics']",
        "resourceGroup": "@parameters('resourceGroupName')"
      },
      "runAfter": {
        "Stop_when_the_run_has_no_verdict": [
          "Succeeded"
        ]
      }
    },
    "Build_the_report": {
      "type": "Http",
      "description": "Runs infra/report.kql on the workspace with this Logic App's managed identity (Log Analytics Reader).",
      "inputs": {
        "method": "POST",
        "uri": "https://api.loganalytics.azure.com/v1/workspaces/@{parameters('workspaceId')}/query",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "query": "@replace(parameters('reportQuery'), '__RUN__', base64(string(outputs('Run_summary'))))"
        },
        "authentication": {
          "type": "ManagedServiceIdentity",
          "audience": "https://api.loganalytics.io"
        }
      },
      "runAfter": {
        "Run_summary": [
          "Succeeded"
        ]
      }
    },
    "Report": {
      "type": "Compose",
      "inputs": "@body('Build_the_report')?['tables']?[0]?['rows']?[0]?[0]",
      "runAfter": {
        "Build_the_report": [
          "Succeeded"
        ]
      }
    },
    "GitHub_token_configured": {
      "type": "If",
      "description": "Posts the report with the fine-grained token a person set (Issues read and write, this repository only).",
      "expression": {
        "and": [
          {
            "equals": [
              "@empty(parameters('githubToken'))",
              false
            ]
          }
        ]
      },
      "actions": {
        "Find_the_open_load_test_Issue": {
          "type": "Http",
          "inputs": {
            "method": "GET",
            "uri": "https://api.github.com/repos/@{parameters('githubRepository')}/issues",
            "headers": {
              "Authorization": "Bearer @{parameters('githubToken')}",
              "Accept": "application/vnd.github+json",
              "X-GitHub-Api-Version": "2022-11-28",
              "User-Agent": "requesthub-load-test-logic-app"
            },
            "queries": {
              "state": "open",
              "labels": "load-test",
              "per_page": "5"
            }
          },
          "runtimeConfiguration": {
            "secureData": {
              "properties": [
                "inputs"
              ]
            }
          },
          "runAfter": {}
        },
        "The_open_Issue": {
          "type": "Compose",
          "inputs": "@first(body('Find_the_open_load_test_Issue'))",
          "runAfter": {
            "Find_the_open_load_test_Issue": [
              "Succeeded"
            ]
          }
        },
        "Passed_or_failed": {
          "type": "Switch",
          "expression": "@outputs('Run')?['testResult']",
          "cases": {
            "Failed": {
              "case": "FAILED",
              "actions": {
                "An_Issue_is_already_open": {
                  "type": "If",
                  "expression": {
                    "and": [
                      {
                        "equals": [
                          "@empty(outputs('The_open_Issue'))",
                          false
                        ]
                      }
                    ]
                  },
                  "actions": {
                    "Comment_on_the_Issue": {
                      "type": "Http",
                      "inputs": {
                        "method": "POST",
                        "uri": "https://api.github.com/repos/@{parameters('githubRepository')}/issues/@{outputs('The_open_Issue')?['number']}/comments",
                        "headers": {
                          "Authorization": "Bearer @{parameters('githubToken')}",
                          "Accept": "application/vnd.github+json",
                          "X-GitHub-Api-Version": "2022-11-28",
                          "User-Agent": "requesthub-load-test-logic-app"
                        },
                        "body": {
                          "body": "`@{outputs('Run')?['displayName']}` also missed its performance criteria.\n\n@{outputs('Report')}"
                        }
                      },
                      "runtimeConfiguration": {
                        "secureData": {
                          "properties": [
                            "inputs"
                          ]
                        }
                      },
                      "runAfter": {}
                    }
                  },
                  "else": {
                    "actions": {
                      "Open_an_Issue": {
                        "type": "Http",
                        "inputs": {
                          "method": "POST",
                          "uri": "https://api.github.com/repos/@{parameters('githubRepository')}/issues",
                          "headers": {
                            "Authorization": "Bearer @{parameters('githubToken')}",
                            "Accept": "application/vnd.github+json",
                            "X-GitHub-Api-Version": "2022-11-28",
                            "User-Agent": "requesthub-load-test-logic-app"
                          },
                          "body": {
                            "title": "[load-test @{parameters('testId')}] RequestHub journey missed its performance criteria",
                            "labels": [
                              "load-test"
                            ],
                            "body": "`@{outputs('Run')?['displayName']}` missed its performance criteria. Azure Load Testing sent the finished run to a Logic App in resource group `@{parameters('resourceGroupName')}`, which wrote this report. The Logic App closes this Issue when a run passes again.\n\n@{outputs('Report')}"
                          }
                        },
                        "runtimeConfiguration": {
                          "secureData": {
                            "properties": [
                              "inputs"
                            ]
                          }
                        },
                        "runAfter": {}
                      }
                    }
                  }
                }
              }
            },
            "Passed": {
              "case": "PASSED",
              "actions": {
                "An_Issue_is_open": {
                  "type": "If",
                  "expression": {
                    "and": [
                      {
                        "equals": [
                          "@empty(outputs('The_open_Issue'))",
                          false
                        ]
                      }
                    ]
                  },
                  "actions": {
                    "Comment_that_it_passes": {
                      "type": "Http",
                      "inputs": {
                        "method": "POST",
                        "uri": "https://api.github.com/repos/@{parameters('githubRepository')}/issues/@{outputs('The_open_Issue')?['number']}/comments",
                        "headers": {
                          "Authorization": "Bearer @{parameters('githubToken')}",
                          "Accept": "application/vnd.github+json",
                          "X-GitHub-Api-Version": "2022-11-28",
                          "User-Agent": "requesthub-load-test-logic-app"
                        },
                        "body": {
                          "body": "`@{outputs('Run')?['displayName']}` passed every criterion. Closing.\n\n@{outputs('Report')}"
                        }
                      },
                      "runtimeConfiguration": {
                        "secureData": {
                          "properties": [
                            "inputs"
                          ]
                        }
                      },
                      "runAfter": {}
                    },
                    "Close_the_Issue": {
                      "type": "Http",
                      "inputs": {
                        "method": "PATCH",
                        "uri": "https://api.github.com/repos/@{parameters('githubRepository')}/issues/@{outputs('The_open_Issue')?['number']}",
                        "headers": {
                          "Authorization": "Bearer @{parameters('githubToken')}",
                          "Accept": "application/vnd.github+json",
                          "X-GitHub-Api-Version": "2022-11-28",
                          "User-Agent": "requesthub-load-test-logic-app"
                        },
                        "body": {
                          "state": "closed",
                          "state_reason": "completed"
                        }
                      },
                      "runtimeConfiguration": {
                        "secureData": {
                          "properties": [
                            "inputs"
                          ]
                        }
                      },
                      "runAfter": {
                        "Comment_that_it_passes": [
                          "Succeeded"
                        ]
                      }
                    }
                  },
                  "else": {
                    "actions": {}
                  }
                }
              }
            }
          },
          "default": {
            "actions": {}
          },
          "runAfter": {
            "The_open_Issue": [
              "Succeeded"
            ]
          }
        }
      },
      "else": {
        "actions": {
          "No_GitHub_token_configured": {
            "type": "Compose",
            "inputs": "No GitHub token configured, so the report was built but not posted. Set GITHUB_ISSUES_TOKEN in the azd environment and run azd provision."
          }
        }
      },
      "runAfter": {
        "Report": [
          "Succeeded"
        ]
      }
    }
  },
  "outputs": {}
}
