{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "loadTestingEndpoint": {
      "type": "string",
      "metadata": {
        "description": "Data-plane endpoint of the Azure Load Testing resource (https://...)."
      }
    },
    "testId": {
      "type": "string",
      "metadata": {
        "description": "Test whose runs this workflow reports, for example requesthub-journey."
      }
    },
    "workspaceId": {
      "type": "string",
      "metadata": {
        "description": "Workspace id of the Log Analytics workspace that holds RequestHub's Application Insights data."
      }
    },
    "resourceGroupName": {
      "type": "string",
      "metadata": {
        "description": "Resource group named in the report, so readers can find the run in the Azure portal."
      }
    },
    "githubRepository": {
      "type": "string",
      "metadata": {
        "description": "Repository (owner/name) whose Issues track a failing journey."
      }
    },
    "githubToken": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "Fine-grained GitHub token for this repository only, with Issues read and write. Empty: the report is built but not posted."
      }
    },
    "reportQuery": {
      "type": "string",
      "metadata": {
        "description": "infra/report.kql: turns the run and the API's telemetry into the Markdown report."
      }
    }
  },
  "triggers": {
    "When_a_test_run_ends": {
      "type": "Request",
      "kind": "Http",
      "inputs": {
        "schema": {}
      },
      "runtimeConfiguration": {
        "concurrency": {
          "runs": 1,
          "maximumWaitingRuns": 10
        }
      },
      "description": "Called by the action group that the test's notification rule sends finished runs to. One run at a time, so two notifications never race to open, comment on, or close the Issue."
    }
  },
  "actions": {
    "Test_run_id": {
      "type": "Compose",
      "description": "The notification uses the Azure Monitor common alert schema; its alert context names the run that ended.",
      "inputs": "@coalesce(triggerBody()?['data']?['data']?['alertContext']?['testRunId'], triggerBody()?['data']?['alertContext']?['testRunId'], '')",
      "runAfter": {}
    },
    "Stop_when_the_notification_names_no_run": {
      "type": "If",
      "description": "Without a run id there is nothing to report: stop at once instead of polling Azure Load Testing.",
      "expression": {
        "and": [
          {
            "equals": [
              "@empty(outputs('Test_run_id'))",
              true
            ]
          }
        ]
      },
      "actions": {
        "No_run_id": {
          "type": "Terminate",
          "inputs": {
            "runStatus": "Failed",
            "runError": {
              "code": "NoTestRunId",
              "message": "The notification carried no test run id."
            }
          }
        }
      },
      "else": {
        "actions": {}
      },
      "runAfter": {
        "Test_run_id": [
          "Succeeded"
        ]
      }
    },
    "Read_the_run": {
      "type": "Http",
      "description": "Reads the run once before waiting, so a call that names another test's run, a run that has not ended, or an old run stops at once and never holds the workflow's single run slot.",
      "inputs": {
        "method": "GET",
        "uri": "@{parameters('loadTestingEndpoint')}/test-runs/@{encodeUriComponent(outputs('Test_run_id'))}",
        "queries": {
          "api-version": "2024-12-01-preview"
        },
        "authentication": {
          "type": "ManagedServiceIdentity",
          "audience": "https://cnt-prod.loadtesting.azure.com"
        }
      },
      "runAfter": {
        "Stop_when_the_notification_names_no_run": [
          "Succeeded"
        ]
      }
    },
    "Stop_when_the_run_belongs_to_another_test": {
      "type": "If",
      "description": "Reports only runs of this Logic App's test. A run of another test, or an id that names no run, stops here.",
      "expression": {
        "and": [
          {
            "not": {
              "equals": [
                "@body('Read_the_run')?['testId']",
                "@parameters('testId')"
              ]
            }
          }
        ]
      },
      "actions": {
        "Not_this_test": {
          "type": "Terminate",
          "inputs": {
            "runStatus": "Failed",
            "runError": {
              "code": "NotThisTest",
              "message": "The run does not belong to the test this Logic App reports."
            }
          }
        }
      },
      "else": {
        "actions": {}
      },
      "runAfter": {
        "Read_the_run": [
          "Succeeded"
        ]
      }
    },
    "Stop_when_the_run_is_not_recent": {
      "type": "If",
      "description": "A notification arrives a few minutes after its run ends. A run that has not ended, or that ended more than 60 minutes ago, comes from a replay or a forged call: it never posts to GitHub.",
      "expression": {
        "or": [
          {
            "equals": [
              "@empty(body('Read_the_run')?['endDateTime'])",
              true
            ]
          },
          {
            "less": [
              "@ticks(coalesce(body('Read_the_run')?['endDateTime'], utcNow()))",
              "@ticks(addMinutes(utcNow(), -60))"
            ]
          }
        ]
      },
      "actions": {
        "Not_a_recent_run": {
          "type": "Terminate",
          "inputs": {
            "runStatus": "Failed",
            "runError": {
              "code": "NotARecentRun",
              "message": "The run has not ended, or it ended more than 60 minutes ago. Only runs that just ended are reported."
            }
          }
        }
      },
      "else": {
        "actions": {}
      },
      "runAfter": {
        "Stop_when_the_run_belongs_to_another_test": [
          "Succeeded"
        ]
      }
    },
    "Initialize_run": {
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "run",
            "type": "object",
            "value": "@body('Read_the_run')"
          }
        ]
      },
      "runAfter": {
        "Stop_when_the_run_is_not_recent": [
          "Succeeded"
        ]
      }
    },
    "Initialize_telemetry_check": {
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "telemetryReady",
            "type": "boolean",
            "value": false
          }
        ]
      },
      "runAfter": {
        "Initialize_run": [
          "Succeeded"
        ]
      }
    },
    "Wait_for_the_verdict": {
      "type": "Until",
      "description": "Reads the run from Azure Load Testing with this Logic App's managed identity (Load Test Reader). A run can reach DONE a minute or two before its statistics and pass/fail verdict are ready, so check once a minute.",
      "expression": "@or(contains(createArray('PASSED', 'FAILED'), variables('run')?['testResult']), equals(variables('run')?['status'], 'CANCELLED'))",
      "limit": {
        "count": 10,
        "timeout": "PT15M"
      },
      "actions": {
        "Get_the_run": {
          "type": "Http",
          "inputs": {
            "method": "GET",
            "uri": "@{parameters('loadTestingEndpoint')}/test-runs/@{encodeUriComponent(outputs('Test_run_id'))}",
            "queries": {
              "api-version": "2024-12-01-preview"
            },
            "authentication": {
              "type": "ManagedServiceIdentity",
              "audience": "https://cnt-prod.loadtesting.azure.com"
            }
          },
          "runAfter": {}
        },
        "Set_run": {
          "type": "SetVariable",
          "inputs": {
            "name": "run",
            "value": "@body('Get_the_run')"
          },
          "runAfter": {
            "Get_the_run": [
              "Succeeded"
            ]
          }
        },
        "Not_final_yet": {
          "type": "If",
          "expression": {
            "and": [
              {
                "equals": [
                  "@contains(createArray('PASSED', 'FAILED'), variables('run')?['testResult'])",
                  false
                ]
              },
              {
                "not": {
                  "equals": [
                    "@variables('run')?['status']",
                    "CANCELLED"
                  ]
                }
              }
            ]
          },
          "actions": {
            "Wait_a_minute": {
              "type": "Wait",
              "inputs": {
                "interval": {
                  "count": 1,
                  "unit": "Minute"
                }
              }
            }
          },
          "else": {
            "actions": {}
          },
          "runAfter": {
            "Set_run": [
              "Succeeded"
            ]
          }
        }
      },
      "runAfter": {
        "Initialize_telemetry_check": [
          "Succeeded"
        ]
      }
    },
    "Run": {
      "type": "Compose",
      "description": "The run that ended.",
      "inputs": "@variables('run')",
      "runAfter": {
        "Wait_for_the_verdict": [
          "Succeeded"
        ]
      }
    },
    "Stop_when_the_run_has_no_verdict": {
      "type": "If",
      "description": "Cancelled runs, and runs without pass/fail criteria results, are not reported.",
      "expression": {
        "and": [
          {
            "not": {
              "contains": [
                "@createArray('PASSED', 'FAILED')",
                "@outputs('Run')?['testResult']"
              ]
            }
          }
        ]
      },
      "actions": {
        "No_verdict": {
          "type": "Terminate",
          "inputs": {
            "runStatus": "Cancelled"
          }
        }
      },
      "else": {
        "actions": {}
      },
      "runAfter": {
        "Run": [
          "Succeeded"
        ]
      }
    },
    "Run_summary": {
      "type": "Compose",
      "description": "Only what the report shows: no endpoints, ids, or environment values.",
      "inputs": {
        "testId": "@outputs('Run')?['testId']",
        "displayName": "@outputs('Run')?['displayName']",
        "status": "@outputs('Run')?['status']",
        "testResult": "@outputs('Run')?['testResult']",
        "startDateTime": "@outputs('Run')?['startDateTime']",
        "endDateTime": "@outputs('Run')?['endDateTime']",
        "virtualUsers": "@outputs('Run')?['virtualUsers']",
        "duration": "@outputs('Run')?['duration']",
        "passFailCriteria": "@outputs('Run')?['passFailCriteria']",
        "testRunStatistics": "@outputs('Run')?['testRunStatistics']",
        "resourceGroup": "@parameters('resourceGroupName')"
      },
      "runAfter": {
        "Stop_when_the_run_has_no_verdict": [
          "Succeeded"
        ]
      }
    },
    "Wait_for_the_telemetry": {
      "type": "Until",
      "description": "Application Insights receives the API's telemetry a few minutes late. Waits until requests from the run's last 90 seconds have arrived, for up to about 8 minutes; if they never do, the report says the telemetry is not available instead of guessing.",
      "expression": "@equals(variables('telemetryReady'), true)",
      "limit": {
        "count": 8,
        "timeout": "PT10M"
      },
      "actions": {
        "Check_the_telemetry": {
          "type": "Http",
          "inputs": {
            "method": "POST",
            "uri": "https://api.loganalytics.azure.com/v1/workspaces/@{parameters('workspaceId')}/query",
            "headers": {
              "Content-Type": "application/json"
            },
            "body": {
              "query": "AppRequests | where TimeGenerated between (datetime(@{outputs('Run')?['startDateTime']}) .. datetime(@{outputs('Run')?['endDateTime']})) | where Name has '/api/' | summarize newest = max(TimeGenerated) | project ready = isnotnull(newest) and newest >= datetime(@{outputs('Run')?['endDateTime']}) - 90s"
            },
            "authentication": {
              "type": "ManagedServiceIdentity",
              "audience": "https://api.loganalytics.io"
            }
          },
          "runAfter": {}
        },
        "Set_telemetry_ready": {
          "type": "SetVariable",
          "inputs": {
            "name": "telemetryReady",
            "value": "@equals(body('Check_the_telemetry')?['tables']?[0]?['rows']?[0]?[0], true)"
          },
          "runAfter": {
            "Check_the_telemetry": [
              "Succeeded"
            ]
          }
        },
        "Not_arrived_yet": {
          "type": "If",
          "expression": {
            "and": [
              {
                "equals": [
                  "@variables('telemetryReady')",
                  false
                ]
              }
            ]
          },
          "actions": {
            "Wait_a_minute_for_the_telemetry": {
              "type": "Wait",
              "inputs": {
                "interval": {
                  "count": 1,
                  "unit": "Minute"
                }
              }
            }
          },
          "else": {
            "actions": {}
          },
          "runAfter": {
            "Set_telemetry_ready": [
              "Succeeded"
            ]
          }
        }
      },
      "runAfter": {
        "Run_summary": [
          "Succeeded"
        ]
      }
    },
    "Build_the_report": {
      "type": "Http",
      "description": "Runs infra/report.kql on the workspace with this Logic App's managed identity (Log Analytics Reader). It returns the Markdown report, the delayed request count, and the verdict.",
      "inputs": {
        "method": "POST",
        "uri": "https://api.loganalytics.azure.com/v1/workspaces/@{parameters('workspaceId')}/query",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "query": "@replace(parameters('reportQuery'), '__RUN__', base64(string(outputs('Run_summary'))))"
        },
        "authentication": {
          "type": "ManagedServiceIdentity",
          "audience": "https://api.loganalytics.io"
        }
      },
      "runAfter": {
        "Wait_for_the_telemetry": [
          "Succeeded",
          "Failed",
          "TimedOut"
        ]
      }
    },
    "Report": {
      "type": "Compose",
      "inputs": "@body('Build_the_report')?['tables']?[0]?['rows']?[0]?[0]",
      "runAfter": {
        "Build_the_report": [
          "Succeeded"
        ]
      }
    },
    "Verdict": {
      "type": "Compose",
      "description": "accepted, warning, expected-failure, regression, no-telemetry, or no-verdict (see report.kql).",
      "inputs": "@body('Build_the_report')?['tables']?[0]?['rows']?[0]?[2]",
      "runAfter": {
        "Report": [
          "Succeeded"
        ]
      }
    },
    "GitHub_token_configured": {
      "type": "If",
      "description": "Posts the report with the fine-grained token a person set (Issues read and write, this repository only).",
      "expression": {
        "and": [
          {
            "equals": [
              "@empty(parameters('githubToken'))",
              false
            ]
          }
        ]
      },
      "actions": {
        "Find_the_open_load_test_Issues": {
          "type": "Http",
          "inputs": {
            "method": "GET",
            "uri": "https://api.github.com/repos/@{parameters('githubRepository')}/issues",
            "headers": {
              "Authorization": "Bearer @{parameters('githubToken')}",
              "Accept": "application/vnd.github+json",
              "X-GitHub-Api-Version": "2022-11-28",
              "User-Agent": "requesthub-load-test-logic-app"
            },
            "queries": {
              "state": "open",
              "labels": "load-test",
              "per_page": "100"
            }
          },
          "runtimeConfiguration": {
            "secureData": {
              "properties": [
                "inputs"
              ]
            }
          },
          "runAfter": {}
        },
        "This_tests_open_Issues": {
          "type": "Query",
          "description": "Only this test's Issues, titled the way the Logic App titles them. The Issues API also lists pull requests: skip them.",
          "inputs": {
            "from": "@body('Find_the_open_load_test_Issues')",
            "where": "@and(startsWith(item()?['title'], concat('[load-test ', parameters('testId'), '] ')), equals(item()?['pull_request'], null))"
          },
          "runAfter": {
            "Find_the_open_load_test_Issues": [
              "Succeeded"
            ]
          }
        },
        "The_open_Issue": {
          "type": "Compose",
          "inputs": "@first(body('This_tests_open_Issues'))",
          "runAfter": {
            "This_tests_open_Issues": [
              "Succeeded"
            ]
          }
        },
        "Passed_or_failed": {
          "type": "Switch",
          "expression": "@outputs('Run')?['testResult']",
          "cases": {
            "Failed": {
              "case": "FAILED",
              "actions": {
                "An_Issue_is_already_open": {
                  "type": "If",
                  "expression": {
                    "and": [
                      {
                        "equals": [
                          "@empty(outputs('The_open_Issue'))",
                          false
                        ]
                      }
                    ]
                  },
                  "actions": {
                    "Comment_on_the_Issue": {
                      "type": "Http",
                      "inputs": {
                        "method": "POST",
                        "uri": "https://api.github.com/repos/@{parameters('githubRepository')}/issues/@{outputs('The_open_Issue')?['number']}/comments",
                        "headers": {
                          "Authorization": "Bearer @{parameters('githubToken')}",
                          "Accept": "application/vnd.github+json",
                          "X-GitHub-Api-Version": "2022-11-28",
                          "User-Agent": "requesthub-load-test-logic-app"
                        },
                        "body": {
                          "body": "`@{outputs('Run')?['displayName']}` also missed its performance criteria.\n\n@{outputs('Report')}"
                        }
                      },
                      "runtimeConfiguration": {
                        "secureData": {
                          "properties": [
                            "inputs"
                          ]
                        }
                      },
                      "runAfter": {}
                    }
                  },
                  "else": {
                    "actions": {
                      "Open_an_Issue": {
                        "type": "Http",
                        "inputs": {
                          "method": "POST",
                          "uri": "https://api.github.com/repos/@{parameters('githubRepository')}/issues",
                          "headers": {
                            "Authorization": "Bearer @{parameters('githubToken')}",
                            "Accept": "application/vnd.github+json",
                            "X-GitHub-Api-Version": "2022-11-28",
                            "User-Agent": "requesthub-load-test-logic-app"
                          },
                          "body": {
                            "title": "[load-test @{parameters('testId')}] RequestHub journey missed its performance criteria",
                            "labels": [
                              "load-test"
                            ],
                            "body": "`@{outputs('Run')?['displayName']}` missed its performance criteria. Azure Load Testing sent the finished run to a Logic App in resource group `@{parameters('resourceGroupName')}`, which wrote this report. The Logic App closes this Issue when a run passes again.\n\n@{outputs('Report')}"
                          }
                        },
                        "runtimeConfiguration": {
                          "secureData": {
                            "properties": [
                              "inputs"
                            ]
                          }
                        },
                        "runAfter": {}
                      }
                    }
                  }
                }
              }
            },
            "Passed": {
              "case": "PASSED",
              "actions": {
                "An_Issue_is_open": {
                  "type": "If",
                  "expression": {
                    "and": [
                      {
                        "equals": [
                          "@empty(outputs('The_open_Issue'))",
                          false
                        ]
                      }
                    ]
                  },
                  "actions": {
                    "The_run_started_after_the_Issue_opened": {
                      "type": "If",
                      "description": "A replayed notification of an older run says nothing about a fix.",
                      "expression": {
                        "and": [
                          {
                            "greater": [
                              "@ticks(outputs('Run')?['startDateTime'])",
                              "@ticks(outputs('The_open_Issue')?['created_at'])"
                            ]
                          }
                        ]
                      },
                      "actions": {
                        "The_report_accepts_the_run": {
                          "type": "If",
                          "description": "Closes the Issue only for an accepted run: the telemetry arrived, and no request carried the rehearsal slowdown.",
                          "expression": {
                            "and": [
                              {
                                "equals": [
                                  "@outputs('Verdict')",
                                  "accepted"
                                ]
                              }
                            ]
                          },
                          "actions": {
                            "Comment_that_it_passes": {
                              "type": "Http",
                              "inputs": {
                                "method": "POST",
                                "uri": "https://api.github.com/repos/@{parameters('githubRepository')}/issues/@{outputs('The_open_Issue')?['number']}/comments",
                                "headers": {
                                  "Authorization": "Bearer @{parameters('githubToken')}",
                                  "Accept": "application/vnd.github+json",
                                  "X-GitHub-Api-Version": "2022-11-28",
                                  "User-Agent": "requesthub-load-test-logic-app"
                                },
                                "body": {
                                  "body": "`@{outputs('Run')?['displayName']}` passed every criterion. Closing.\n\n@{outputs('Report')}"
                                }
                              },
                              "runtimeConfiguration": {
                                "secureData": {
                                  "properties": [
                                    "inputs"
                                  ]
                                }
                              },
                              "runAfter": {}
                            },
                            "Close_the_Issue": {
                              "type": "Http",
                              "inputs": {
                                "method": "PATCH",
                                "uri": "https://api.github.com/repos/@{parameters('githubRepository')}/issues/@{outputs('The_open_Issue')?['number']}",
                                "headers": {
                                  "Authorization": "Bearer @{parameters('githubToken')}",
                                  "Accept": "application/vnd.github+json",
                                  "X-GitHub-Api-Version": "2022-11-28",
                                  "User-Agent": "requesthub-load-test-logic-app"
                                },
                                "body": {
                                  "state": "closed",
                                  "state_reason": "completed"
                                }
                              },
                              "runtimeConfiguration": {
                                "secureData": {
                                  "properties": [
                                    "inputs"
                                  ]
                                }
                              },
                              "runAfter": {
                                "Comment_that_it_passes": [
                                  "Succeeded"
                                ]
                              }
                            }
                          },
                          "else": {
                            "actions": {
                              "Comment_that_the_Issue_stays_open": {
                                "type": "Http",
                                "inputs": {
                                  "method": "POST",
                                  "uri": "https://api.github.com/repos/@{parameters('githubRepository')}/issues/@{outputs('The_open_Issue')?['number']}/comments",
                                  "headers": {
                                    "Authorization": "Bearer @{parameters('githubToken')}",
                                    "Accept": "application/vnd.github+json",
                                    "X-GitHub-Api-Version": "2022-11-28",
                                    "User-Agent": "requesthub-load-test-logic-app"
                                  },
                                  "body": {
                                    "body": "`@{outputs('Run')?['displayName']}` passed its criteria, but the report does not accept it, so this Issue stays open.\n\n@{outputs('Report')}"
                                  }
                                },
                                "runtimeConfiguration": {
                                  "secureData": {
                                    "properties": [
                                      "inputs"
                                    ]
                                  }
                                },
                                "runAfter": {}
                              }
                            }
                          }
                        }
                      },
                      "else": {
                        "actions": {
                          "Older_run": {
                            "type": "Compose",
                            "inputs": "The run started before the open Issue was created, so it does not close it."
                          }
                        }
                      }
                    }
                  },
                  "else": {
                    "actions": {}
                  }
                }
              }
            }
          },
          "default": {
            "actions": {}
          },
          "runAfter": {
            "The_open_Issue": [
              "Succeeded"
            ]
          }
        }
      },
      "else": {
        "actions": {
          "No_GitHub_token_configured": {
            "type": "Compose",
            "inputs": "No GitHub token configured, so the report was built but not posted. Set GITHUB_ISSUES_TOKEN in the azd environment and run azd provision."
          }
        }
      },
      "runAfter": {
        "Verdict": [
          "Succeeded"
        ]
      }
    }
  },
  "outputs": {}
}
