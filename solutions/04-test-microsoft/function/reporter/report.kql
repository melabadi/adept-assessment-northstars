// The API's server-side requests during one Azure Load Testing run, per operation (Test phase, Microsoft track).
//
// The function (reporter/services.py) replaces __START__ and __END__ with the run's start and end, as checked ISO 8601
// times, and runs this query on the Log Analytics workspace that holds RequestHub's Application Insights data, with
// its managed identity (Log Analytics Reader). reporter/report.py turns the rows into the report and its verdict, and
// reporter/flow.py waits until `newest` reaches the end of the run before it reports.
let started = datetime(__START__);
let ended = datetime(__END__);
// Under load, Application Insights keeps only a sample of the requests. ItemCount says how many requests a kept row
// stands for, so the sums estimate the real counts wherever the sampler records it. In practice the counts can still
// run below the client's; the report says so.
AppRequests
| where TimeGenerated between (started .. ended)
| where Name has '/api/'
| summarize requests = sum(ItemCount), server_errors = sumif(ItemCount, toint(ResultCode) >= 500),
    denied = sumif(ItemCount, ResultCode in ('401', '403')), p95 = percentilew(DurationMs, ItemCount, 95),
    delayed = sumif(ItemCount, isnotempty(tostring(Properties['requesthub.fault.queue_delay_ms']))),
    newest = max(TimeGenerated)
    by Name
| order by Name asc
